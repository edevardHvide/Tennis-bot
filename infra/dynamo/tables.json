[
  {
    "TableName": "tennis-users",
    "KeySchema": [
      { "AttributeName": "userId", "KeyType": "HASH" }
    ],
    "AttributeDefinitions": [
      { "AttributeName": "userId", "AttributeType": "S" }
    ],
    "BillingMode": "PAY_PER_REQUEST",
    "Comment": "Registered subscribers. userId = email address."
  },
  {
    "TableName": "tennis-preferences",
    "KeySchema": [
      { "AttributeName": "userId", "KeyType": "HASH" },
      { "AttributeName": "preferenceId", "KeyType": "RANGE" }
    ],
    "AttributeDefinitions": [
      { "AttributeName": "userId", "AttributeType": "S" },
      { "AttributeName": "preferenceId", "AttributeType": "S" }
    ],
    "BillingMode": "PAY_PER_REQUEST",
    "Comment": "Per-user alert preferences. Fields: facilityId, sport, courtType, dates[], timeFrom, timeTo."
  },
  {
    "TableName": "tennis-availability",
    "KeySchema": [
      { "AttributeName": "facilityId", "KeyType": "HASH" },
      { "AttributeName": "date", "KeyType": "RANGE" }
    ],
    "AttributeDefinitions": [
      { "AttributeName": "facilityId", "AttributeType": "S" },
      { "AttributeName": "date", "AttributeType": "S" }
    ],
    "BillingMode": "PAY_PER_REQUEST",
    "Comment": "Cached scraper snapshot per facility+sport+date. facilityId uses composite key: facility#sport (e.g. ota#padel)."
  },
  {
    "TableName": "tennis-notifications",
    "KeySchema": [
      { "AttributeName": "notificationId", "KeyType": "HASH" }
    ],
    "AttributeDefinitions": [
      { "AttributeName": "notificationId", "AttributeType": "S" }
    ],
    "BillingMode": "PAY_PER_REQUEST",
    "TimeToLiveSpecification": {
      "Enabled": true,
      "AttributeName": "ttl"
    },
    "Comment": "Sent notification history for deduplication. Hash includes sport for independent dedup. Items expire after 24h (ttl = unix epoch)."
  },
  {
    "TableName": "tennis-weather",
    "KeySchema": [
      { "AttributeName": "region", "KeyType": "HASH" },
      { "AttributeName": "hourIso", "KeyType": "RANGE" }
    ],
    "AttributeDefinitions": [
      { "AttributeName": "region", "AttributeType": "S" },
      { "AttributeName": "hourIso", "AttributeType": "S" }
    ],
    "BillingMode": "PAY_PER_REQUEST",
    "TimeToLiveSpecification": {
      "Enabled": true,
      "AttributeName": "ttl"
    },
    "Comment": "Hourly weather forecasts from yr.no. PK=region (oslo|bergen|fredrikstad), SK=Oslo-local hourIso. Items expire ~14 days after the forecast hour."
  }
]
